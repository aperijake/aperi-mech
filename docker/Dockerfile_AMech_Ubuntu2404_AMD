# syntax=docker/dockerfile:1.4

# Dockerfile for building an AMD GPU (ROCm/HIP) environment for the amech project on Ubuntu 24.04

# Base image, Ubuntu 24.04
FROM ubuntu:24.04

# Set the default shell to bash
SHELL ["/bin/bash", "-c"]

# ROCm version to install
ARG ROCM_VERSION=7.1

# Define a build argument for the AMD GPU architecture, defaulting to gfx942 (MI300X)
ARG AMD_ARCH=gfx942

# Define the user and group id
ARG USER_ID=1000
ARG GROUP_ID=1000

# Add build arg for optional Azure mirror
ARG USE_AZURE_MIRROR=false

# Branch for the source code
ARG SRC_BRANCH=main
ARG SPACK_BRANCH=releases/v1.1

# Validate AMD_ARCH input
RUN if ! [[ "$AMD_ARCH" =~ ^gfx[0-9a-z]+$ ]]; then \
        echo "Error: AMD_ARCH must be a GFX architecture string (e.g. gfx942), not '${AMD_ARCH}'" && \
        exit 1; \
    fi && \
    echo "AMD_ARCH set to: ${AMD_ARCH}"

# Set AMD GPU architecture env var (used during Spack concretize and build)
ENV AMD_ARCH=${AMD_ARCH}
ENV ROCM_VERSION=${ROCM_VERSION}

# Verify user and group IDs are numbers
RUN if ! [[ "$USER_ID" =~ ^[0-9]+$ ]] || ! [[ "$GROUP_ID" =~ ^[0-9]+$ ]]; then \
        echo "Error: USER_ID and GROUP_ID must be numbers, not '${USER_ID}' and '${GROUP_ID}'" && \
        exit 1; \
    fi && \
    echo "USER_ID set to: ${USER_ID}" && \
    echo "GROUP_ID set to: ${GROUP_ID}"

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Optionally use Azure mirror for faster apt speeds
RUN if [ "$USE_AZURE_MIRROR" = "true" ]; then \
        sed -i 's|URIs: http://.*\.ubuntu\.com/ubuntu/|URIs: http://azure.archive.ubuntu.com/ubuntu/|' /etc/apt/sources.list.d/ubuntu.sources && \
        echo "Updated ubuntu.sources:" && cat /etc/apt/sources.list.d/ubuntu.sources; \
    fi

#################### ROCm Installation ####################
# Install prerequisites for ROCm repository setup
# trunk-ignore(checkov/CKV2_DOCKER_1)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gpg \
    gpg-agent \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Add AMD ROCm GPG key and apt repository
RUN mkdir -p /etc/apt/keyrings && \
    wget -q -O /tmp/rocm.gpg.key https://repo.radeon.com/rocm/rocm.gpg.key && \
    gpg --dearmor -o /etc/apt/keyrings/rocm.gpg /tmp/rocm.gpg.key && \
    rm /tmp/rocm.gpg.key && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} noble main" \
        > /etc/apt/sources.list.d/rocm.list && \
    echo "deb [arch=amd64,i386 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/graphics/${ROCM_VERSION}/ubuntu noble main" \
        >> /etc/apt/sources.list.d/rocm.list && \
    printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' \
        > /etc/apt/preferences.d/rocm-pin-600

# Install ROCm HIP SDK and developer tools
# trunk-ignore(checkov/CKV2_DOCKER_1)
RUN apt-get update && apt-get install -y --no-install-recommends \
    rocm-hip-sdk \
    rocm-developer-tools \
    rocm-smi-lib \
    rocminfo \
    hipcc \
    hip-dev \
    hip-runtime-amd \
    && rm -rf /var/lib/apt/lists/*

# Set ROCm environment variables
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=${ROCM_PATH}/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_PATH}/lib:${ROCM_PATH}/lib64:${LD_LIBRARY_PATH}

# Simple verification of ROCm installation
RUN hipcc --version && \
    ls -l ${ROCM_PATH}/include/hip/hip_runtime.h && \
    ls -l ${ROCM_PATH}/lib/libamdhip64.so && \
    echo "ROCm verification complete"

#################### System Packages from apt ####################
# Install necessary packages
# trunk-ignore(checkov/CKV2_DOCKER_1)
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    chrpath \
    cmake \
    coreutils \
    desktop-file-utils \
    environment-modules \
    file \
    fuse \
    gfortran \
    git \
    git-lfs \
    htop \
    lcov \
    libaec-dev \
    libbz2-dev \
    libcurl4-openssl-dev \
    libfuse2 \
    libgl1 \
    libglu1-mesa \
    libhwloc-dev \
    liblz4-dev \
    libncurses-dev \
    libopenblas-dev \
    libsnappy-dev \
    libssl-dev \
    libtool \
    libxml2-dev \
    libzstd-dev \
    lsb-release \
    openssh-client \
    openssl \
    patchelf \
    pkgconf \
    python3 \
    python3-dev \
    python3-full \
    python3-venv \
    python3-pip \
    sudo \
    unzip \
    vim \
    xorg \
    zip \
    && rm -rf /var/lib/apt/lists/*

#################### AppImage Tools ####################
# Download and install AppImage tools for bundling
# Auto-detect architecture and download appropriate binaries
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        APPIMAGE_ARCH="aarch64"; \
    elif [ "$ARCH" = "x86_64" ]; then \
        APPIMAGE_ARCH="x86_64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    echo "Detected architecture: $ARCH, downloading AppImage tools for: $APPIMAGE_ARCH" && \
    mkdir -p /opt/appimage-tools && \
    cd /opt/appimage-tools && \
    curl -L -o appimagetool "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${APPIMAGE_ARCH}.AppImage" && \
    chmod +x appimagetool && \
    curl -L -o linuxdeploy "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${APPIMAGE_ARCH}.AppImage" && \
    chmod +x linuxdeploy && \
    ln -s /opt/appimage-tools/appimagetool /usr/local/bin/appimagetool && \
    ln -s /opt/appimage-tools/linuxdeploy /usr/local/bin/linuxdeploy

#################### User Setup ####################
# Check if UID exists and handle accordingly, modify if exists, create if not. Can be set to match host for easy file sharing
RUN if getent passwd ${USER_ID} > /dev/null; then \
      echo "UID ${USER_ID} already exists, modifying existing user" && \
      existing_user=$(getent passwd ${USER_ID} | cut -d: -f1) && \
      usermod -l amech_docker $existing_user && \
      groupmod -n amech_docker $(id -gn $USER_ID) && \
      usermod -d /home/amech_docker -m amech_docker; \
    else \
      # Create the group first if it doesn't exist
      if ! getent group ${GROUP_ID}; then \
        groupadd -g ${GROUP_ID} amech_docker; \
      fi && \
      useradd -u ${USER_ID} -g ${GROUP_ID} -m amech_docker; \
    fi

# Add amech_docker to render and video groups for AMD GPU device access
# render: required for /dev/dri/renderDxxx access
# video: required for /dev/dri/cardx access
RUN usermod -aG render amech_docker 2>/dev/null || true && \
    usermod -aG video amech_docker 2>/dev/null || true

# Switch back to root user
USER root

# Configure passwordless sudo for the user
RUN echo "amech_docker ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Make the working directory
WORKDIR /home/amech_docker

# Set the HOME environment variable
ENV HOME=/home/amech_docker

# Set the default command to bash
CMD ["/bin/bash"]

# Add GitHub to known_hosts BEFORE any git operations to avoid host key verification errors
RUN mkdir -p /root/.ssh && \
    ssh-keyscan github.com >> /root/.ssh/known_hosts

# Clone only the tools/ directory from aperi-mech using sparse checkout
RUN git clone --filter=blob:none --sparse https://github.com/aperijake/aperi-mech.git ${HOME}/amech && \
    cd ${HOME}/amech && \
    git sparse-checkout set tools && \
    git checkout "$SRC_BRANCH" && \
    rm -rf .git

# Ensure the amech directory is owned by the amech user
RUN chown -R amech_docker:amech_docker ${HOME}/amech

# Change to the new user
USER amech_docker

# Change to the cloned repository directory
WORKDIR ${HOME}/amech

# Automatically activate the venv for interactive shells
RUN echo "source ${HOME}/amech/venv/bin/activate" >> ${HOME}/.bashrc

# Set Fortran compiler and amech environment variables globally
ENV AMECH_ROOT=${HOME}/amech
ENV FC=/usr/bin/gfortran
ENV F77=/usr/bin/gfortran

# Set up Python virtual environment and install required tooling
# Note: imppy3d is automatically installed from git as specified in pyproject.toml
RUN python3 -m venv venv && \
    . ./venv/bin/activate && \
    echo "export AMECH_ROOT=$AMECH_ROOT" >> $AMECH_ROOT/venv/bin/activate && \
    cd $AMECH_ROOT/tools/python/amech && \
    python3 -m pip install -e . && \
    cd $AMECH_ROOT/tools/python/spackx && \
    python3 -m pip install -e .

# Install Spack and add it to the virtual environment
RUN mkdir -p $AMECH_ROOT/venv/src && \
    cd $AMECH_ROOT/venv/src && \
    git clone https://github.com/spack/spack.git && \
    git -C $AMECH_ROOT/venv/src/spack checkout ${SPACK_BRANCH} && \
    echo "source $AMECH_ROOT/venv/src/spack/share/spack/setup-env.sh" >> $AMECH_ROOT/venv/bin/activate

# Configure the Spack environment
RUN . ./venv/bin/activate && \
    spack compiler find && \
    spack external find && \
    spack external find hwloc libxml2 pkgconf bzip2 lz4 snappy zstd libaec ncurses openblas autoconf automake libtool

# Patch Spack for Trilinos support
RUN . ./venv/bin/activate && \
    spack patch-trilinos

# Manually register ROCm packages in Spack packages.yaml
# spack external find does not reliably detect ROCm, so we configure it explicitly
# First remove any auto-detected llvm-amdgpu entry to avoid duplicate YAML keys
RUN . ./venv/bin/activate && \
    ROCM_VER=$(cat /opt/rocm/.info/version 2>/dev/null || echo "${ROCM_VERSION}.0") && \
    mkdir -p ~/.spack && \
    python3 -c "import re; f=open('$HOME/.spack/packages.yaml'); c=f.read(); f.close(); c=re.sub(r'  llvm-amdgpu:\n(    .*\n)*','',c); f=open('$HOME/.spack/packages.yaml','w'); f.write(c); f.close()" && \
    echo "  hip:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: hip@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  llvm-amdgpu:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: llvm-amdgpu@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "      extra_attributes:" >> ~/.spack/packages.yaml && \
    echo "        compilers:" >> ~/.spack/packages.yaml && \
    echo "          c: /opt/rocm/bin/amdclang" >> ~/.spack/packages.yaml && \
    echo "          cxx: /opt/rocm/bin/amdclang++" >> ~/.spack/packages.yaml && \
    echo "          fortran: /opt/rocm/bin/amdflang" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  hsa-rocr-dev:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: hsa-rocr-dev@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  rocblas:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: rocblas@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  rocthrust:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: rocthrust@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  rocprim:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: rocprim@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml && \
    echo "  comgr:" >> ~/.spack/packages.yaml && \
    echo "    externals:" >> ~/.spack/packages.yaml && \
    echo "    - spec: comgr@${ROCM_VER}" >> ~/.spack/packages.yaml && \
    echo "      prefix: /opt/rocm" >> ~/.spack/packages.yaml && \
    echo "    buildable: false" >> ~/.spack/packages.yaml

# Create a Spack environment for amech and install it
RUN . ./venv/bin/activate && \
    spack env create amech && \
    spack -e amech develop --path $AMECH_ROOT amech ~openmp +rocm amdgpu_target=${AMD_ARCH} build_type=Release && \
    spack -e amech add amech ~openmp +rocm amdgpu_target=${AMD_ARCH} build_type=Release && \
    spack -e amech concretize -f

# Just breaking up and installing the dependencies in a few steps to give a docker build cache
RUN . ./venv/bin/activate && \
    spack -e amech install eigen yaml-cpp googletest

RUN . ./venv/bin/activate && \
    spack -e amech install kokkos kokkos-kernels compadre

RUN . ./venv/bin/activate && \
    spack -e amech install trilinos

# Set environment variables for amech
ENV AMECH_ENV="amech"
ENV AMECH_GPU_ENV="amech"

# Register the local amech Spack repository so the amech repo can be found for future builds
RUN . ./venv/bin/activate && \
    spack -e amech repo add $AMECH_ROOT/tools/python/spackx/src/spackx/repos/amech/

# When running the container with AMD GPU access, use:
#   docker run --device /dev/kfd --device /dev/dri -it aperi-mech:ubuntu24.04-rocm7.1
#
# To get the build location of amech, you can run:
#   spack location -i amech build_type=Release
# Then cd to the bin folder in that directory to run the unit tests
#
# Or, use the do_configure script to build manually:
#   ./do_configure -p release
#   cd build/Release && make -j8

#################### Level 1: Build-Time Smoke Tests ####################
# Run basic validation tests during build to catch issues early
RUN . ./venv/bin/activate && \
    echo "Running build-time smoke tests..." && \
    # Test 1: Python environment
    python3 --version && \
    python3 -c "import spackx; import amech" && \
    # Test 2: Spack works
    spack --version && \
    spack env list | grep -q amech && \
    # Test 3: Core tools present
    which git cmake gcc gfortran && \
    # Test 4: ROCm toolkit
    hipcc --version && \
    [ -f /opt/rocm/lib/libamdhip64.so ] && \
    # Test 5: Dependencies findable
    spack find trilinos kokkos eigen | grep -q trilinos && \
    echo "✓ All build-time smoke tests passed"

# Generic healthcheck to ensure the container is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD [ "bash", "-c", "echo 'Container is healthy'" ]
